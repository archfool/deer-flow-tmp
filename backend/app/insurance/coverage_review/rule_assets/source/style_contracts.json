{
  "version": "style-v2.1",
  "temperature_priority": ["fear", "defensive", "cold_start", "neutral", "open"],
  "contracts": {
    "open": ["接住客户已有思考", "较快进入事实", "不重复教育保险原理"],
    "fear": ["先共情再给确定性", "数字延后出现", "把主动权交还客户"],
    "defensive": ["先说明不是来增加负担", "先盘点够不够", "不推动加保"],
    "cold_start": ["先给值得花时间的理由", "先服务后需求", "开场不出现产品"],
    "neutral": ["务实直接", "使用真实处境和数字", "语气平稳"]
  },
  "universal_guardrails": [
    "不得制造焦虑或保证收益",
    "不得创造客户事实、保单条款或测算数字",
    "不得输出具体产品名、产品代号或缴费方案",
    "必须显式展示保留项和无需动作项"
  ],
  "boundary_patterns": [
    "建议投保",
    "推荐购买",
    "产品代码",
    "缴费期",
    "保证收益",
    "收益率",
    "最后机会"
  ]
}

