TURE":["先说明这种配置偏差很常见，再客观指出家庭责任与配置重心不一致。","纠错不评价客户判断能力，也不直接处置具体保单。"],"DEBT_ANCHOR":["未偿债务不会因家庭支柱发生风险而消失。","以精算结果中的负债责任缺口作为硬数字锚点。"],"EARNING_CAPACITY_IMPACT":["伤残风险的核心是持续工作能力下降及长期收入影响。","同时关注康复和照护对家庭现金流的持续影响。"],"FAMILY_NEED_PLUS_HLV":["家庭需求下限由家庭生活责任、未偿债务与已明确的长期责任构成。","生命价值上限用于说明未来收入贡献，不直接作为投保建议。","现有身故保障从目标责任中扣减后形成权威缺口。"],"FUTURE_EXPIRY":["展示现有保障到期后的未来空白，但不自动建议退换旧单。"],"HNW_TRIANGLE":["传承维从人生、财富与传承三角架构出发。","重点讨论控制权、确定性与按意愿传递。"],"LIQUIDITY_MONTHS":["应急流动性只说明家庭备用金可以覆盖的支出月数。","该指标不是保障缺口，不生成保险动作。"],"MEDICAL_LIABILITY_LAYERS":["医疗保障按具体责任范围判断是否覆盖，不把责任空白硬换算成金额。","重点说明当前尚缺哪些关键医疗责任以及可能形成的自费敞口。"],"NO_NEED_EXPLANATION":["主动说明当前人生阶段暂不需要该维，而不是跳过不说。"],"PRESERVE_LEGACY_POLICY":["只有逐单条款证据充分时，才可判断旧单是否值得特别保留。"],"PRESERVE_NO_DUPLICATION":["该维继续叠加的边际价值较低，建议把资源留给更需要的方向。"],"PRESERVE_SUFFICIENT":["该维已达到精算充足标准，明确建议维持。","不把已充足项目改写成继续优化或继续购买。"],"RETIREMENT_CASHFLOW":["养老维按目标退休现金流与已有养老金或商业现金流的差解释。","重点是每期现金流缺口，不跨单位比较总额。"],"TERM_CHANGE":["说明保障环境可能变化，具体条款判断必须由逐单证据支持。"],"TREATMENT_PLUS_INCOME":["疾病风险同时影响治疗支出和康复期收入。","目标值、已有值与缺口值均直接引用精算结果。"],"WEALTH_CERTAINTY":["财富管理维只讨论长期资金的稳定性与确定性。","不得使用收益承诺或未经批准的收益率数字。"]},"narrative_skeletons":{"cold_start":["先说明检视价值","建立服务关系","再进入事实","给客户选择权"],"defensive":["先卸下销售防御","克制说明现状","只做必要推演","不增加负担地收口"],"fear":["充分共情","主动收敛推演","轻带事实而不渲染","把主动权交还客户"],"neutral":["务实确认处境","引用真实事实","解释影响","平稳收口"],"open":["接住当前处境","用真实事实具象化","按数字推演后果","低压力收口"]},"narrative_type_skeletons":{"correction":{"cold_start":["先建立服务价值","客观呈现结构问题","说明为何先核对","不推动立即调整"],"defensive":["先说明不是否定旧选择","核对结构错位","不直接处置保单","给客户保留决定权"],"fear":["先避免归责","只陈述已确认错位","收敛可能影响","交由代理人复核"],"neutral":["陈述结构事实","说明影响","先核对再补缺口","平稳收口"],"open":["先说明配置偏差很常见","指出事实错位","解释对家庭责任的影响","先核对再决定调整"]},"no_need":{"cold_start":["先展示检视不只找缺口","明确当前无需增加","说明阶段依据","再进入其他维度"],"defensive":["先明确不会要求增加","给出无需动作结论","说明判断边界","保留客户主动权"],"fear":["先降低焦虑","说明当前无需增加","不制造新的风险负担","未来条件变化再复检"],"neutral":["说明当前阶段","给出无需动作结论","解释判断边界","平稳收口"],"open":["主动说明当前无需增加","解释人生阶段依据","明确不为齐全而购买","保留未来复检"]},"preserve":{"cold_start":["先用保留项建立信任","说明已有安排的价值","明确无需重复购